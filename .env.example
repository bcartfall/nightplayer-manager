# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=3001

# --- Storage --------------------------------------------------------------
# Where finished videos live, as seen by THIS process. Must be the same
# folder YTPTube downloads into.
DOWNLOAD_PATH=/mnt/media/yt-dlp/downloads
# The gateway's own SQLite database
DB_PATH=./data/gateway.db

# --- yt-dlp UI plugin -----------------------------------------------------
# Name of a file in src/plugins/ (without .js): ytdlp (self-hosted) or ytptube
YTDLP_UI=ytptube

# --- Self-hosted yt-dlp plugin (YTDLP_UI=ytdlp) --------------------------------
# Runs the yt-dlp installed in the Docker image. All optional.
#YTDLP_BIN=yt-dlp
#YTDLP_CONCURRENCY=2               # simultaneous downloads, the rest wait in a queue
#YTDLP_FORMAT=bv*+ba/b             # yt-dlp -f
#YTDLP_SORT=res:1080,ext:mp4:m4a   # yt-dlp -S  (max 1080p, prefer browser-playable mp4)
#YTDLP_MERGE_FORMAT=mp4
#YTDLP_OUTPUT_TEMPLATE=%(title).150B [%(id)s].%(ext)s   # relative to DOWNLOAD_PATH
#YTDLP_COOKIES=/data/cookies.txt   # Netscape cookies file
#YTDLP_RATE_LIMIT=5M               # bytes/s per download
#YTDLP_JS_RUNTIMES=node            # JS runtime for YouTube; empty to disable
#YTDLP_EXTRA_ARGS=--proxy socks5://host:1080
#YTDLP_STATE_DIR=./data/ytdlp      # job files (resume after restart) + yt-dlp cache

# --- YTPTube plugin ---------------------------------------------------------
YTPTUBE_URL=http://127.0.0.1:8081
# Only if YTPTube has YTP_AUTH_USERNAME / YTP_AUTH_PASSWORD set
#YTPTUBE_USER=
#YTPTUBE_PASSWORD=
# Optional: YTPTube preset / sub-folder / filename template for gateway downloads
#YTPTUBE_PRESET=default
#YTPTUBE_FOLDER=
#YTPTUBE_TEMPLATE=
# The downloads folder as YTPTube sees it (only matters if it reports absolute
# file paths, e.g. inside Docker)
YTPTUBE_DOWNLOAD_PATH=/downloads

# --- Optional -------------------------------------------------------------
# How often active downloads are checked against the UI
POLL_INTERVAL_MS=1500
# Set both to serve HTTP/2 (with HTTP/1.1 fallback) directly from Node.
# Leave empty to serve plain HTTP/1.1 (e.g. behind a TLS-terminating proxy).
TLS_KEY=
TLS_CERT=
# Access-Control-Allow-Origin for browsers on other origins
CORS_ORIGIN=*

# --- Storyboards ------------------------------------------------------------
# A .sbb preview file is generated next to each finished video (needs ffmpeg).
#STORYBOARD=1
#FFMPEG_BIN=ffmpeg
